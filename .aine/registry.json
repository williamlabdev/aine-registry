    {"id": "registry-manifest-schema", "path": "registry/schema/project-manifest.v1.schema.json", "kind": "project_manifest_schema", "role": "schema", "source_of_truth": "registry.manifest_schema", "status": "present", "risk": "critical", "approval_required": true}
