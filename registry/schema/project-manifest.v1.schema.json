{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aine.dev/schemas/project-manifest.v1.schema.json",
  "title": "AINE Project Manifest v1",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "owner": {"type": "string"},
        "ownership": {
          "type": "object",
          "properties": {
            "team": {"type": "string"},
            "owners": {"type": "array", "items": {"type": "string"}},
            "delegates": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "kind": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "risk": {"type": "object"},
        "approval_required": {"type": "boolean"},
        "policy": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["advisory", "enforced"]},
            "require_approval_for": {"type": "array", "items": {"type": "string"}},
            "deny_unknown_changes": {"type": "boolean"},
            "required_checks": {"type": "array", "items": {"type": "string"}},
            "authorization": {
              "type": "object",
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "effect"],
                    "properties": {
                      "id": {"type": "string"},
                      "effect": {"enum": ["allow", "deny", "review_required"]},
                      "actions": {"type": "array", "items": {"type": "string"}},
                      "roles": {"type": "array", "items": {"type": "string"}},
                      "teams": {"type": "array", "items": {"type": "string"}},
                      "requires_ownership": {"type": "boolean"},
                      "conditions": {"type": "object"},
                      "evidence": {"type": "array", "items": {"type": "string"}}
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "role": {"enum": ["source", "generated", "projection", "evidence", "deployment", "config", "schema", "unknown"]},
          "status": {"type": "string"},
          "source_of_truth": {"type": ["string", "boolean", "null"]},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "approval_required": {"type": "boolean"},
          "provenance": {"type": "object"},
          "consumers": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": {"type": "string"},
          "kind": {"type": "string"},
          "strength": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": {"type": "string"},
          "relationship_type": {"type": "string"},
          "kind": {"type": "string"},
          "strength": {"type": "string"},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "source_of_truth": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    }
  },
  "additionalProperties": true
}
